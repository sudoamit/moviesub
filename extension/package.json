{
  "name": "quant-2-ai-assistant",
  "displayName": "Quant_2 AI Assistant",
  "description": "Better than Copilot/Blackbox: Repo-aware autocomplete + chat",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [{
        "id": "quant2-sidebar",
        "title": "Quant_2 AI",
        "icon": "media/icon.svg"
      }]
    },
    "views": {
      "quant2-sidebar": [{
        "type": "webview",
        "id": "quant2-chat",
        "name": "Chat"
      }]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./" ,
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@types/node": "18.x",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "axios": "^1.7.7"
  }
}
