datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum SubscriptionTier {
  FREE
  PRO
  ADVANCED
}

enum AssetType {
  INDEX
  EQUITY
  CRYPTO
  COMMODITY
  FOREX
}

enum Timeframe {
  M1   @map("1m")
  M5   @map("5m")
  M15  @map("15m")
  M30  @map("30m")
  H1   @map("1h")
  H4   @map("4h")
  D1   @map("1d")
}

enum Direction {
  BULLISH
  BEARISH
  NEUTRAL
}

enum SignalState {
  PENDING
  ACTIVE
  TP1_HIT
  TP2_HIT
  TP3_HIT
  SL_HIT
  EXPIRED
  INVALIDATED
  CANCELLED
}

enum SignalGrade {
  A_PLUS
  A
  B
  C
  NO_TRADE
}

enum MarketRegimeType {
  BULLISH_TREND
  BEARISH_TREND
  RANGE
  HIGH_VOLATILITY
  LOW_VOLATILITY
}

enum StructureType {
  SWING_HIGH
  SWING_LOW
  HIGHER_HIGH
  HIGHER_LOW
  LOWER_HIGH
  LOWER_LOW
}

enum LiquidityType {
  EQUAL_HIGHS
  EQUAL_LOWS
  BUY_SIDE
  SELL_SIDE
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  name         String?
  role         Role          @default(USER)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  subscription Subscription?
  watchlists   Watchlist[]
  alerts       Alert[]
  backtests    Backtest[]
  strategies   Strategy[]

  @@map("users")
}

model Subscription {
  id         String           @id @default(uuid())
  userId     String           @unique
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier       SubscriptionTier @default(FREE)
  validUntil DateTime?
  isActive   Boolean          @default(true)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@map("subscriptions")
}

model Instrument {
  id               String            @id @default(uuid())
  symbol           String            @unique
  name             String
  exchange         String
  assetType        AssetType
  tickSize         Decimal           @db.Decimal(12, 6)
  lotSize          Int               @default(1)
  contractSize     Decimal           @default(1) @db.Decimal(12, 4)
  currency         String            @default("INR")
  tradingHoursJson Json?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  candles          Candle[]
  marketStructures MarketStructure[]
  liquidityEvents  LiquidityEvent[]
  fairValueGaps    FairValueGap[]
  orderBlocks      OrderBlock[]
  signals          Signal[]
  marketRegimes    MarketRegime[]
  backtests        Backtest[]
  watchlistItems   WatchlistItem[]

  @@index([exchange, assetType])
  @@map("instruments")
}

model Candle {
  id           String     @id @default(uuid())
  instrumentId String
  instrument   Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  timeframe    Timeframe
  timestamp    DateTime
  open         Decimal    @db.Decimal(18, 6)
  high         Decimal    @db.Decimal(18, 6)
  low          Decimal    @db.Decimal(18, 6)
  close        Decimal    @db.Decimal(18, 6)
  volume       Decimal    @db.Decimal(24, 6)
  isClosed     Boolean    @default(true)
  createdAt    DateTime   @default(now())

  @@unique([instrumentId, timeframe, timestamp])
  @@index([instrumentId, timeframe, timestamp(sort: Desc)])
  @@map("candles")
}

model MarketStructure {
  id            String        @id @default(uuid())
  instrumentId  String
  instrument    Instrument    @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  timeframe     Timeframe
  structureType StructureType
  direction     Direction
  price         Decimal       @db.Decimal(18, 6)
  candleTime    DateTime
  confirmedAt   DateTime
  isBOS         Boolean       @default(false)
  isCHoCH       Boolean       @default(false)
  brokenLevel   Decimal?      @db.Decimal(18, 6)
  strength      Decimal       @default(1.0) @db.Decimal(5, 2)
  createdAt     DateTime      @default(now())

  @@index([instrumentId, timeframe, candleTime(sort: Desc)])
  @@map("market_structures")
}

model LiquidityEvent {
  id             String        @id @default(uuid())
  instrumentId   String
  instrument     Instrument    @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  timeframe      Timeframe
  liquidityType  LiquidityType
  priceLevel     Decimal       @db.Decimal(18, 6)
  sweepPrice     Decimal?      @db.Decimal(18, 6)
  isSwept        Boolean       @default(false)
  sweepTimestamp DateTime?
  displacement   Decimal?      @db.Decimal(18, 6)
  createdAt      DateTime      @default(now())

  @@index([instrumentId, timeframe, isSwept])
  @@map("liquidity_events")
}

model FairValueGap {
  id             String     @id @default(uuid())
  instrumentId   String
  instrument     Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  timeframe      Timeframe
  direction      Direction
  upperBound     Decimal    @db.Decimal(18, 6)
  lowerBound     Decimal    @db.Decimal(18, 6)
  candleTime     DateTime
  isFilled       Boolean    @default(false)
  filledAt       DateTime?
  fillPercentage Decimal    @default(0) @db.Decimal(5, 2)
  isInvalidated  Boolean    @default(false)
  createdAt      DateTime   @default(now())

  @@index([instrumentId, timeframe, isFilled, isInvalidated])
  @@map("fair_value_gaps")
}

model OrderBlock {
  id            String     @id @default(uuid())
  instrumentId  String
  instrument    Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  timeframe     Timeframe
  direction     Direction
  high          Decimal    @db.Decimal(18, 6)
  low           Decimal    @db.Decimal(18, 6)
  candleTime    DateTime
  isMitigated   Boolean    @default(false)
  mitigatedAt   DateTime?
  isInvalidated Boolean    @default(false)
  strength      Decimal    @default(1.0) @db.Decimal(5, 2)
  createdAt     DateTime   @default(now())

  @@index([instrumentId, timeframe, isMitigated, isInvalidated])
  @@map("order_blocks")
}

model MarketRegime {
  id           String           @id @default(uuid())
  instrumentId String
  instrument   Instrument       @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  timeframe    Timeframe
  regime       MarketRegimeType
  atr          Decimal          @db.Decimal(18, 6)
  adx          Decimal          @db.Decimal(8, 4)
  volatility   Decimal          @db.Decimal(8, 4)
  timestamp    DateTime
  createdAt    DateTime         @default(now())

  @@index([instrumentId, timeframe, timestamp(sort: Desc)])
  @@map("market_regimes")
}

model Strategy {
  id          String              @id @default(uuid())
  userId      String?
  user        User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  name        String
  description String?
  isDefault   Boolean             @default(false)
  configJson  Json
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  parameters  StrategyParameter[]
  signals     Signal[]
  backtests   Backtest[]

  @@map("strategies")
}

model StrategyParameter {
  id         String   @id @default(uuid())
  strategyId String
  strategy   Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  key        String
  value      String
  valueType  String

  @@unique([strategyId, key])
  @@map("strategy_parameters")
}

model Signal {
  id              String          @id @default(uuid())
  instrumentId    String
  instrument      Instrument      @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  strategyId      String?
  strategy        Strategy?       @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  direction       Direction
  state           SignalState     @default(PENDING)
  grade           SignalGrade
  score           Int
  timeframe       Timeframe
  entryPrice      Decimal         @db.Decimal(18, 6)
  stopLoss        Decimal         @db.Decimal(18, 6)
  target1         Decimal         @db.Decimal(18, 6)
  target2         Decimal         @db.Decimal(18, 6)
  target3         Decimal?        @db.Decimal(18, 6)
  riskRewardRatio Decimal         @db.Decimal(6, 2)
  exitPrice       Decimal?        @db.Decimal(18, 6)
  pnlAmount       Decimal?        @db.Decimal(18, 6)
  pnlRMultiple    Decimal?        @db.Decimal(6, 2)
  reasonsJson     Json
  risksJson       Json
  activatedAt     DateTime?
  closedAt        DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  features        SignalFeature[]

  @@index([instrumentId, state, createdAt(sort: Desc)])
  @@index([state, score(sort: Desc)])
  @@map("signals")
}

model SignalFeature {
  id           String   @id @default(uuid())
  signalId     String
  signal       Signal   @relation(fields: [signalId], references: [id], onDelete: Cascade)
  featureType  String
  scoreValue   Int
  metadataJson Json?

  @@index([signalId])
  @@map("signal_features")
}

model Backtest {
  id                   String          @id @default(uuid())
  userId               String?
  user                 User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  strategyId           String?
  strategy             Strategy?       @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  instrumentId         String
  instrument           Instrument      @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  timeframe            Timeframe
  startDate            DateTime
  endDate              DateTime
  initialCapital       Decimal         @db.Decimal(18, 2)
  riskPerTradePercent  Decimal         @db.Decimal(5, 2)
  totalTrades          Int             @default(0)
  winningTrades        Int             @default(0)
  losingTrades         Int             @default(0)
  winRate              Decimal         @default(0) @db.Decimal(5, 2)
  profitFactor         Decimal         @default(0) @db.Decimal(8, 4)
  netPnL               Decimal         @default(0) @db.Decimal(18, 2)
  averageR             Decimal         @default(0) @db.Decimal(6, 2)
  expectancy           Decimal         @default(0) @db.Decimal(10, 4)
  maxDrawdownPercent   Decimal         @default(0) @db.Decimal(5, 2)
  maxConsecutiveLosses Int             @default(0)
  sharpeRatio          Decimal?        @db.Decimal(8, 4)
  parametersJson       Json
  createdAt            DateTime        @default(now())

  trades               BacktestTrade[]

  @@index([instrumentId, createdAt(sort: Desc)])
  @@map("backtests")
}

model BacktestTrade {
  id           String      @id @default(uuid())
  backtestId   String
  backtest     Backtest    @relation(fields: [backtestId], references: [id], onDelete: Cascade)
  direction    Direction
  entryTime    DateTime
  entryPrice   Decimal     @db.Decimal(18, 6)
  exitTime     DateTime
  exitPrice    Decimal     @db.Decimal(18, 6)
  stopLoss     Decimal     @db.Decimal(18, 6)
  takeProfit   Decimal     @db.Decimal(18, 6)
  positionSize Decimal     @db.Decimal(18, 4)
  pnl          Decimal     @db.Decimal(18, 2)
  pnlRMultiple Decimal     @db.Decimal(6, 2)
  exitReason   SignalState

  @@index([backtestId, entryTime])
  @@map("backtest_trades")
}

model Watchlist {
  id        String          @id @default(uuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  items     WatchlistItem[]

  @@map("watchlists")
}

model WatchlistItem {
  id           String     @id @default(uuid())
  watchlistId  String
  watchlist    Watchlist  @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  instrumentId String
  instrument   Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, instrumentId])
  @@map("watchlist_items")
}

model Alert {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   String
  target    String
  minScore  Int         @default(80)
  minGrade  SignalGrade @default(A)
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@map("alerts")
}

enum AIModelStatus {
  CANDIDATE
  ACTIVE
  ARCHIVED
  REJECTED
}

model AIModel {
  id                  String           @id @default(uuid())
  name                String           @unique
  description         String?
  algorithm           String           @default("LOGISTIC_REGRESSION")
  activeVersionId     String?          @unique
  activeVersion       AIModelVersion?  @relation("ActiveVersion", fields: [activeVersionId], references: [id])
  versions            AIModelVersion[] @relation("ModelVersions")
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@map("ai_models")
}

model AIModelVersion {
  id                      String             @id @default(uuid())
  modelId                 String
  model                   AIModel            @relation("ModelVersions", fields: [modelId], references: [id], onDelete: Cascade)
  version                 String
  featureSchemaVersion    String             @default("1.0")
  status                  AIModelStatus      @default(CANDIDATE)
  weightsJson             Json
  bias                    Float              @default(0.0)
  hyperparametersJson     Json
  metricsJson             Json
  trainingExampleCount    Int
  validationExampleCount  Int
  outOfSampleExampleCount Int
  trainingStartedAt       DateTime?
  trainingCompletedAt     DateTime?
  activeForModel          AIModel?           @relation("ActiveVersion")
  trainingRuns            AITrainingRun[]
  predictions             AIPrediction[]
  featureImportances      AIFeatureImportance[]
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  @@unique([modelId, version])
  @@map("ai_model_versions")
}

model AITrainingRun {
  id                  String          @id @default(uuid())
  modelVersionId      String
  modelVersion        AIModelVersion  @relation(fields: [modelVersionId], references: [id], onDelete: Cascade)
  status              String          @default("COMPLETED")
  epochsTrained       Int
  initialLoss         Float
  finalLoss           Float
  metricsJson         Json
  walkForwardJson     Json?
  startedAt           DateTime        @default(now())
  completedAt         DateTime?

  @@map("ai_training_runs")
}

model AITrainingExample {
  id                      String    @id @default(uuid())
  signalId                String?
  symbol                  String
  featureSchemaVersion    String    @default("1.0")
  featureVectorJson       Json
  label                   Int       // 0 or 1
  outcomeR                Float
  predictionTimestamp     DateTime
  availableForTrainingAt  DateTime
  createdAt               DateTime  @default(now())

  @@index([symbol, predictionTimestamp])
  @@index([availableForTrainingAt])
  @@map("ai_training_examples")
}

model AIPrediction {
  id                      String          @id @default(uuid())
  signalId                String?
  modelVersionId          String
  modelVersion            AIModelVersion  @relation(fields: [modelVersionId], references: [id], onDelete: Cascade)
  symbol                  String
  timeframe               String          @default("15m")
  probability             Float
  confidenceLower         Float?
  confidenceUpper         Float?
  confidenceStatus        String          @default("INSUFFICIENT_DATA")
  expectedValueR          Float
  recommendation          String          // HIGH_CONFIDENCE, MODERATE_CONFIDENCE, LOW_CONFIDENCE, WAIT
  sampleSize              Int             @default(0)
  featuresJson            Json
  createdAt               DateTime        @default(now())

  @@index([symbol, createdAt])
  @@map("ai_predictions")
}

model AIFeatureImportance {
  id                  String          @id @default(uuid())
  modelVersionId      String
  modelVersion        AIModelVersion  @relation(fields: [modelVersionId], references: [id], onDelete: Cascade)
  featureName         String
  weight              Float
  absoluteWeight      Float
  rank                Int

  @@unique([modelVersionId, featureName])
  @@map("ai_feature_importances")
}

model AIPostMortem {
  id                  String    @id @default(uuid())
  signalId            String?
  symbol              String
  patternType         String    // e.g. "MARKET_PATTERN"
  classification      String    // e.g. "LIQUIDITY_SWEEP_FAILURE", "HTF_COUNTERTREND"
  expectedWinRate     Float
  realizedOutcomeR    Float
  analysisSummary     String
  keyFactorsJson      Json
  createdAt           DateTime  @default(now())

  @@index([symbol, patternType])
  @@map("ai_post_mortems")
}

model TradingExperience {
  id                    String    @id @default(uuid())
  tradeId               String    @unique
  signalId              String?
  symbol                String
  assetType             String
  action                String    // BUY, SELL, WAIT, NO_TRADE
  score                 Float
  grade                 String?
  entryPrice            Float
  entryTime             DateTime
  exitPrice             Float?
  exitTime              DateTime?
  stopLoss              Float
  target1               Float?
  target2               Float?
  target3               Float?
  riskAmount            Float?
  expectedR             Float?
  probabilityWin        Float?
  probabilityTP1        Float?
  probabilityTP2        Float?
  probabilityStopFirst  Float?
  confidence            Float?
  outcomeStatus         String    // WIN, LOSS, TIMEOUT, SCRATCH
  pnl                   Float
  pnlR                  Float
  maxFavorableExcursion Float     @default(0.0)
  maxAdverseExcursion   Float     @default(0.0)
  holdingTimeSeconds    Int       @default(0)
  outcomeClassification String    // GOOD_TRADE_WIN, GOOD_TRADE_LOSS, BAD_TRADE_WIN, BAD_TRADE_LOSS, etc.
  regime                String
  volatilityRegime      String
  session               String
  dayOfWeek             Int
  reasonsJson           Json
  failureReasonsJson    Json
  marketSnapshotJson    Json
  strategyVersion       String    @default("v1.0")
  modelVersion          String?
  featureSchemaVersion  String    @default("2.0")
  createdAt             DateTime  @default(now())

  @@index([symbol, createdAt])
  @@index([outcomeClassification])
  @@index([strategyVersion])
  @@map("trading_experiences")
}

model LearningRun {
  id                  String    @id @default(uuid())
  startedAt           DateTime  @default(now())
  completedAt         DateTime?
  trainingStart       DateTime
  trainingEnd         DateTime
  evaluationStart     DateTime
  evaluationEnd       DateTime
  experiencesUsed     Int
  featuresTested      Int
  hypothesesGenerated Int
  candidatesGenerated Int
  candidatesPromoted  Int
  candidatesRejected  Int
  status              String    @default("COMPLETED")
  metricsJson         Json?
  summary             String?

  @@map("learning_runs")
}

model LearningHypothesis {
  id                  String    @id @default(uuid())
  title               String
  type                String    // POSITIVE_PATTERN, NEGATIVE_FILTER, FEATURE_REMOVAL, PARAMETER_TWEAK
  conditionRulesJson  Json
  sampleSize          Int
  expectancy          Float
  winRate             Float
  confidenceLower     Float
  confidenceUpper     Float
  status              String    @default("DISCOVERED") // DISCOVERED, TESTING, VALIDATED, PROMOTED, REJECTED
  rejectionReason     String?
  createdAt           DateTime  @default(now())
  lastValidatedAt     DateTime?

  @@map("learning_hypotheses")
}

model StrategyCandidate {
  id                        String    @id @default(uuid())
  baseStrategyVersion       String
  candidateVersion          String
  type                      String    // FILTER, THRESHOLD, FEATURE, MODEL, REGIME, VOLATILITY, EXIT, POSITION_SIZE
  description               String
  changeJson                Json
  sampleSize                Int
  expectancyBefore          Float
  expectancyAfterHistorical Float
  walkForwardExpectancy     Float?
  monteCarloRuinProbability Float?
  status                    String    @default("GENERATED") // GENERATED, BACKTESTING, VALIDATED, SHADOW, PROMOTED, REJECTED, ROLLED_BACK
  rejectionReason           String?
  createdAt                 DateTime  @default(now())
  promotedAt                DateTime?

  @@map("strategy_candidates")
}

model ShadowTrade {
  id                String    @id @default(uuid())
  candidateId       String
  symbol            String
  timeframe         String    @default("15m")
  signalDirection   String
  entryPrice        Float
  entryTime         DateTime
  exitPrice         Float?
  exitTime          DateTime?
  pnl               Float?
  pnlR              Float?
  isProductionMatch Boolean   @default(false)
  createdAt         DateTime  @default(now())

  @@index([candidateId, symbol])
  @@map("shadow_trades")
}

model ModelPromotion {
  id                  String    @id @default(uuid())
  strategyVersion     String
  modelVersion        String
  previousVersion     String
  reason              String
  evidenceJson        Json
  promotedBy          String    @default("SYSTEM_PROMOTION_GATE")
  promotedAt          DateTime  @default(now())

  @@map("model_promotions")
}

model ModelRollback {
  id                  String    @id @default(uuid())
  fromVersion         String
  toVersion           String
  triggerReason       String
  evidenceJson        Json
  executedAt          DateTime  @default(now())

  @@map("model_rollbacks")
}

model DriftEvent {
  id                  String    @id @default(uuid())
  driftType           String    // FEATURE_DRIFT, PREDICTION_DRIFT, PERFORMANCE_DRIFT, REGIME_DRIFT, EXECUTION_DRIFT
  strategyVersion     String
  modelVersion        String
  severity            String    // LOW, MEDIUM, HIGH, CRITICAL
  description         String
  metricsJson         Json
  detectedAt          DateTime  @default(now())

  @@index([strategyVersion, driftType])
  @@map("drift_events")
}

model LearningMemory {
  id                  String    @id @default(uuid())
  memoryType          String    // PROVEN_PATTERN, FAILURE_PATTERN, REJECTED_HYPOTHESIS, REGIME_RULE
  key                 String    @unique
  summary             String
  detailsJson         Json
  sampleSize          Int       @default(0)
  confidence          Float     @default(0.0)
  status              String    @default("ACTIVE")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("learning_memories")
}

model ResearchExperiment {
  id                        String    @id @default(uuid())
  experimentHash            String    @unique
  hypothesisId              String?
  hypothesis                String
  instrument                String
  timeframe                 String    @default("15m")
  baseStrategyVersion       String
  candidateStrategyVersion  String
  featureSchemaVersion      String    @default("2.0")
  datasetMetadataJson       Json
  trainingPeriodJson        Json
  validationPeriodJson      Json
  testPeriodJson            Json
  holdoutPeriodJson         Json
  sampleSize                Int
  baselineMetricsJson       Json
  candidateMetricsJson      Json
  robustnessMetricsJson     Json
  slippageStressJson        Json?
  missedTradeStressJson     Json?
  monteCarloMetricsJson     Json?
  benchmarksJson            Json?
  complexityJson            Json?
  status                    String    @default("PASSED") // RUNNING, PASSED, FAILED, REJECTED
  rejectionReasonsJson      Json?
  passedOutOfSample         Boolean   @default(true)
  passedHoldout             Boolean   @default(true)
  createdAt                 DateTime  @default(now())
  completedAt               DateTime?

  @@index([instrument, timeframe])
  @@index([status])
  @@map("research_experiments")
}

model ResearchScorecard {
  id                          String    @id @default(uuid())
  experiencesCount            Int
  newPatternsDiscovered       Int
  hypothesesGenerated         Int
  experimentsExecuted         Int
  candidatesGenerated         Int
  candidatesPassedOOS         Int
  candidatesInShadow          Int
  candidatesPromoted          Int
  candidatesRejected          Int
  currentProductionVersion    String
  bestCandidateVersion        String?
  expectedImprovementDeltaR   Float     @default(0.0)
  systemState                 String    @default("IMPROVING") // IMPROVING, OBSERVING_PLATEAU, DRIFT_ALERT
  scorecardDataJson           Json
  reportDate                  DateTime  @default(now())

  @@map("research_scorecards")
}

model ResearchKnowledgeNode {
  id            String    @id @default(uuid())
  nodeType      String    // REGIME, SETUP, FEATURE, ENTRY_QUALITY, EXIT_QUALITY, OUTCOME, ERROR
  name          String    @unique
  propertiesJson Json?
  frequency     Int       @default(0)
  averageR      Float     @default(0.0)
  winRate       Float     @default(0.0)
  updatedAt     DateTime  @default(now())

  @@index([nodeType])
  @@map("research_knowledge_nodes")
}

enum OrderState {
  CREATED
  RISK_CHECKED
  REJECTED
  SUBMITTED
  ACKNOWLEDGED
  PARTIALLY_FILLED
  FILLED
  CANCEL_REQUESTED
  CANCELLED
  FAILED
}

enum PositionState {
  PENDING
  OPEN
  PARTIALLY_CLOSED
  CLOSING
  CLOSED
  INVALIDATED
}

enum TradingMode {
  BACKTEST
  PAPER
  SHADOW
  LIVE
}

enum RiskRejectionReason {
  DAILY_LOSS_LIMIT
  POSITION_SIZE_LIMIT
  POSITION_RISK_LIMIT
  EXPOSURE_LIMIT
  TOTAL_EXPOSURE_LIMIT
  TRADE_COUNT_LIMIT
  MAX_TRADES_PER_DAY
  MAX_OPEN_POSITIONS
  CONSECUTIVE_LOSS_LIMIT
  MAX_CONSECUTIVE_LOSSES
  MAX_LEVERAGE
  INVALID_STOP_LOSS
  MISSING_STOP_LOSS
  INVALID_TAKE_PROFIT
  MISSING_TAKE_PROFIT
  INVALID_RISK_REWARD
  STALE_MARKET_DATA
  MARKET_DATA_UNAVAILABLE
  TRADING_DISABLED
  DUPLICATE_ORDER
  INSUFFICIENT_MARGIN
}

model PaperAccount {
  id               String              @id @default(uuid())
  name             String              @default("Primary Paper Account")
  currency         String              @default("INR")
  initialCapital   Decimal             @default(1000000.0) @db.Decimal(18, 2)
  cashBalance      Decimal             @default(1000000.0) @db.Decimal(18, 2)
  usedMargin       Decimal             @default(0.0) @db.Decimal(18, 2)
  realizedPnL      Decimal             @default(0.0) @db.Decimal(18, 2)
  totalChargesPaid Decimal             @default(0.0) @db.Decimal(18, 2)
  tradingMode      TradingMode         @default(PAPER)
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  orders           PaperOrder[]
  positions        PaperPosition[]
  trades           PaperTrade[]
  snapshots        PortfolioSnapshot[]

  @@map("paper_accounts")
}

model PaperOrder {
  id                String              @id @default(uuid())
  accountId         String
  account           PaperAccount        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  symbol            String
  contractSymbol    String
  instrumentType    String              @default("SPOT") // SPOT, OPTION
  strike            Decimal?            @db.Decimal(18, 4)
  optionType        String?             // CE, PE
  direction         Direction           // BULLISH/BEARISH or BUY/SELL
  orderType         String              @default("MARKET") // MARKET, LIMIT
  requestedQuantity Decimal             @db.Decimal(18, 4)
  filledQuantity    Decimal             @default(0.0) @db.Decimal(18, 4)
  price             Decimal?            @db.Decimal(18, 6)
  triggerPrice      Decimal?            @db.Decimal(18, 6)
  stopLoss          Decimal?            @db.Decimal(18, 6)
  target1           Decimal?            @db.Decimal(18, 6)
  target2           Decimal?            @db.Decimal(18, 6)
  target3           Decimal?            @db.Decimal(18, 6)
  leverage          Decimal             @default(1.0) @db.Decimal(5, 2)
  status            OrderState          @default(CREATED)
  rejectionReason   RiskRejectionReason?
  rejectionDetails  String?
  idempotencyKey    String              @unique
  signalId          String?
  correlationId     String
  submittedAt       DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  fills             PaperFill[]
  positions         PaperPosition[]

  @@index([accountId, symbol, status])
  @@index([correlationId])
  @@map("paper_orders")
}

model PaperFill {
  id               String       @id @default(uuid())
  orderId          String
  order            PaperOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fillPrice        Decimal      @db.Decimal(18, 6)
  fillQuantity     Decimal      @db.Decimal(18, 4)
  fee              Decimal      @default(0.0) @db.Decimal(18, 4)
  feeBreakdownJson Json?
  slippage         Decimal      @default(0.0) @db.Decimal(18, 6)
  liquidityType    String       @default("TAKER") // MAKER, TAKER
  sourceTimestamp  DateTime
  fillTimestamp    DateTime     @default(now())
  correlationId    String
  createdAt        DateTime     @default(now())

  @@index([orderId, fillTimestamp])
  @@index([correlationId])
  @@map("paper_fills")
}

model PaperPosition {
  id                    String        @id @default(uuid())
  accountId             String
  account               PaperAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  orderId               String?
  order                 PaperOrder?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  symbol                String
  contractSymbol        String
  instrumentType        String        @default("SPOT")
  strike                Decimal?      @db.Decimal(18, 4)
  optionType            String?
  direction             Direction
  quantity              Decimal       @db.Decimal(18, 4)
  entryPrice            Decimal       @db.Decimal(18, 6)
  entryTime             DateTime      @default(now())
  currentPrice          Decimal       @db.Decimal(18, 6)
  stopLoss              Decimal?      @db.Decimal(18, 6)
  initialStopLoss       Decimal?      @db.Decimal(18, 6)
  target1               Decimal?      @db.Decimal(18, 6)
  target2               Decimal?      @db.Decimal(18, 6)
  target3               Decimal?      @db.Decimal(18, 6)
  initialTarget1        Decimal?      @db.Decimal(18, 6)
  initialTarget2        Decimal?      @db.Decimal(18, 6)
  initialTarget3        Decimal?      @db.Decimal(18, 6)
  leverage              Decimal       @default(1.0) @db.Decimal(5, 2)
  usedMargin            Decimal       @default(0.0) @db.Decimal(18, 2)
  unrealizedPnL         Decimal       @default(0.0) @db.Decimal(18, 2)
  unrealizedR           Decimal       @default(0.0) @db.Decimal(6, 2)
  maxFavorableExcursion Decimal       @default(0.0) @db.Decimal(18, 6)
  maxAdverseExcursion   Decimal       @default(0.0) @db.Decimal(18, 6)
  status                PositionState @default(OPEN)
  partialFillsJson      Json?
  executionEventsJson   Json?
  trailingStopStateJson Json?
  chargesJson           Json?
  openedAt              DateTime      @default(now())
  closedAt              DateTime?
  correlationId         String
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  trades                PaperTrade[]

  @@index([accountId, symbol, status])
  @@index([status])
  @@index([correlationId])
  @@map("paper_positions")
}

model PaperTrade {
  id                     String        @id @default(uuid())
  accountId              String
  account                PaperAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  positionId             String?
  position               PaperPosition? @relation(fields: [positionId], references: [id], onDelete: SetNull)
  symbol                 String
  contractSymbol         String
  instrumentType         String        @default("SPOT")
  strike                 Decimal?      @db.Decimal(18, 4)
  optionType             String?
  direction              Direction
  quantity               Decimal       @db.Decimal(18, 4)
  entryPrice             Decimal       @db.Decimal(18, 6)
  exitPrice              Decimal       @db.Decimal(18, 6)
  realizedPnL            Decimal       @db.Decimal(18, 2)
  realizedR              Decimal       @db.Decimal(6, 2)
  maxFavorableExcursion  Decimal       @default(0.0) @db.Decimal(18, 6)
  maxAdverseExcursion    Decimal       @default(0.0) @db.Decimal(18, 6)
  holdingDurationSeconds Int           @default(0)
  entryTime              DateTime
  exitTime               DateTime      @default(now())
  exitReason             String
  chargesJson            Json?
  signalSnapshotJson     Json?
  outcomeClassification  String?       // WIN_TP1, WIN_TP2, WIN_TP3_RUNNER, LOSS_SL, BREAKEVEN, MANUAL
  correlationId          String
  createdAt              DateTime      @default(now())

  @@index([accountId, symbol, exitTime(sort: Desc)])
  @@index([correlationId])
  @@map("paper_trades")
}

model PortfolioSnapshot {
  id                 String       @id @default(uuid())
  accountId          String
  account            PaperAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  timestamp          DateTime     @default(now())
  totalEquity        Decimal      @db.Decimal(18, 2)
  cashBalance        Decimal      @db.Decimal(18, 2)
  usedMargin         Decimal      @db.Decimal(18, 2)
  availableMargin    Decimal      @db.Decimal(18, 2)
  unrealizedPnL      Decimal      @db.Decimal(18, 2)
  realizedPnL        Decimal      @db.Decimal(18, 2)
  grossLeverage      Decimal      @default(0.0) @db.Decimal(5, 2)
  openPositionCount  Int          @default(0)
  winRate            Decimal      @default(0.0) @db.Decimal(5, 2)
  profitFactor       Decimal      @default(0.0) @db.Decimal(8, 4)
  drawdownPercent    Decimal      @default(0.0) @db.Decimal(5, 2)

  @@index([accountId, timestamp(sort: Desc)])
  @@map("portfolio_snapshots")
}

model AuditEvent {
  id            String   @id @default(uuid())
  timestamp     DateTime @default(now())
  actor         String   @default("SYSTEM") // SYSTEM, USER, WORKER, RISK_ENGINE
  service       String   // API, WORKER, TRADING_ENGINE, RISK_ENGINE
  eventType     String   // SIGNAL_CREATED, ORDER_CREATED, ORDER_REJECTED, ORDER_SUBMITTED, ORDER_FILLED, POSITION_OPENED, POSITION_MODIFIED, POSITION_CLOSED, RISK_REJECTED, TRADING_ENABLED, TRADING_DISABLED, EMERGENCY_STOP, MODEL_TRAINED, MODEL_PROMOTED, MODEL_REJECTED
  entityType    String   // SIGNAL, ORDER, FILL, POSITION, TRADE, ACCOUNT, MODEL, CONFIG
  entityId      String
  payloadJson   Json?
  correlationId String

  @@index([eventType, timestamp(sort: Desc)])
  @@index([entityId, entityType])
  @@index([correlationId])
  @@map("audit_events")
}

model TradingSystemConfig {
  id                      String   @id @default("SYSTEM_DEFAULT")
  paperTradingEnabled     Boolean  @default(true)
  liveTradingEnabled      Boolean  @default(false)
  emergencyStop           Boolean  @default(false)
  maxDailyLossPercent     Decimal  @default(3.0) @db.Decimal(5, 2)
  maxPositionRiskPercent  Decimal  @default(1.0) @db.Decimal(5, 2)
  maxTotalExposurePercent Decimal  @default(20.0) @db.Decimal(5, 2)
  maxOpenPositions        Int      @default(5)
  maxTradesPerDay         Int      @default(20)
  maxConsecutiveLosses    Int      @default(3)
  maxLeverage             Decimal  @default(5.0) @db.Decimal(5, 2)
  maxSlippageBps          Int      @default(50)
  maxMarketDataAgeSeconds Int      @default(5)
  updatedBy               String   @default("SYSTEM")
  updatedAt               DateTime @updatedAt

  @@map("trading_system_configs")
}


